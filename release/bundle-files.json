    "release/evidence/console-pro/build-attribution.json",
    "release/evidence/platform-gateway/build-attribution.json",
    "release/evidence/platform-gateway/sbom.json",
    "release/evidence/platform-gateway/attestation.signed.json",
    "release/evidence/platform-gateway/signing-record.json",
    "release/evidence/platform-gateway-anchor-4601ca9/build-attribution.json",
    "helm/intentgate/Chart.yaml",
    "helm/intentgate/values.yaml",
    "helm/intentgate/.helmignore",
    "helm/intentgate/LICENSE",
    "helm/intentgate/templates/_helpers.tpl",
    "helm/intentgate/templates/components.yaml",
    "helm/intentgate/templates/NOTES.txt",
    "helm/intentgate/templates/serviceaccount.yaml"
